<?xml version="1.0" encoding="UTF-8"?>
<!-- Tier 2 (optional) workflow example — a single-step process wrapping one agent version as an
     external task. Only relevant if you adopt the BPMN engine upgrade described in LLD.md §7/S1
     in BUILD-PLAN.md. Tier 1 (default) uses a plain JSON steps array instead; see
     DB-SCHEMA.sql's workflow_version.steps column and API-ROUTES.md's Workflows section. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   id="Definitions_example" targetNamespace="http://agentsource.example">
  <bpmn:process id="example-agent-workflow" name="Example agent workflow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Triggered">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="RunAgentTask" name="Run agent version"
                       camunda:type="external" camunda:topic="agent-runtime">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_1" name="Completed">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="RunAgentTask" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="RunAgentTask" targetRef="EndEvent_1" />
  </bpmn:process>
</bpmn:definitions>
