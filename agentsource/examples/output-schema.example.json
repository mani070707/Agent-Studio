{
  "name": "example-agent-output-v1",
  "kind": "output",
  "jsonSchema": {
    "type": "object",
    "required": ["summary", "findings"],
    "properties": {
      "summary": { "type": "string" },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["label", "confidence"],
          "properties": {
            "label": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    }
  }
}
