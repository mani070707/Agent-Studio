# Supabase project (Auth + Postgres + Storage) — create at supabase.com (free tier),
# then run api/migrations/001_init.sql against it (SQL editor or psql) before starting the API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=agent-studio-content

# Project Settings -> Database -> Connection string (use the "Session pooler" URI on the free tier)
DATABASE_URL=postgresql://postgres:PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Key encrypting user_secret.encrypted_value (BYOK LLM keys). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# The deployed web app's origin(s), comma-separated. Include http://localhost:3000 for local dev.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Shared secret the external cron job sends as X-Internal-Cron-Secret to trigger scheduled
# agent runs. Generate any random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_CRON_SECRET=

JWT_AUDIENCE=authenticated

# Local development only. Never enable this in a deployed environment.
DISABLE_AUTH=false
LOCAL_DEV_USER_ID=
