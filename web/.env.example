# Supabase project (Auth + Postgres + Storage) — create at supabase.com (free tier)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI base URL. Leave blank in the browser to use the Next.js /api proxy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_PROXY_TARGET=http://localhost:8000

# Local development only. Never enable this in a deployed environment.
NEXT_PUBLIC_DISABLE_AUTH=false
