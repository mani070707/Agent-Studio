# Supabase project (Auth + Postgres + Storage) — create at supabase.com (free tier),
# then run api/migrations/001_init.sql against it (SQL editor or psql) before starting the API.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT.supabase.co/auth/v1
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=agent-studio-content

# Project Settings -> Database -> Connection string (use the "Session pooler" URI on the free tier)
DATABASE_URL=postgresql://postgres:PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Key encrypting user_secret.encrypted_value (BYOK LLM keys). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# The deployed web app's origin(s), comma-separated. Include http://localhost:3000 for local dev.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Shared secret the external cron job sends as X-Internal-Cron-Secret to trigger scheduled
# agent runs. Generate any random string, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_CRON_SECRET=

JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# Local development only. Never enable this in a deployed environment.
DISABLE_AUTH=false
LOCAL_DEV_USER_ID=
ENVIRONMENT=local
METRICS_TOKEN=

# Run one durable document-ingestion worker inside the API process. Disable this when a
# separate `python -m app.worker` process is deployed.
EMBEDDED_INGESTION_WORKER=true
INGESTION_POLL_SECONDS=2
INGESTION_LEASE_SECONDS=120

# Local English semantic embeddings. Changing model or index version requires explicit reindexing.
EMBEDDED_INDEXING_WORKER=true
INDEXING_POLL_SECONDS=2
INDEXING_LEASE_SECONDS=600
INDEXING_TIMEOUT_SECONDS=300
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.model-cache
EMBEDDING_BATCH_SIZE=32
INDEXING_WORKER_CONCURRENCY=1
SEMANTIC_INDEX_VERSION=1
PRELOAD_EMBEDDING_MODEL=true

# Durable deterministic RAG evaluation worker.
EMBEDDED_EVALUATION_WORKER=true
EVALUATION_POLL_SECONDS=2
EVALUATION_LEASE_SECONDS=900

# Agent Studio keeps traces locally; no LangSmith account or external prompt telemetry is used.
LANGSMITH_TRACING=false

# Exactly 32 characters. Generate separately from SECRET_ENCRYPTION_KEY.
CHECKPOINT_ENCRYPTION_KEY=
EMBEDDED_WORKFLOW_WORKER=true
WORKFLOW_POLL_SECONDS=2
WORKFLOW_LEASE_SECONDS=900
WORKFLOW_CHECKPOINT_RETENTION_DAYS=30
CONVERSATION_RETENTION_DAYS=30
CONVERSATION_CLEANUP_SECONDS=3600
EVENT_RETENTION_DAYS=7
EVENT_POLL_SECONDS=1
EVENT_BATCH_SIZE=100
SSE_MAX_CONNECTIONS_PER_TENANT=3
SSE_MAX_DURATION_SECONDS=300
WORKER_HEARTBEAT_SECONDS=20
